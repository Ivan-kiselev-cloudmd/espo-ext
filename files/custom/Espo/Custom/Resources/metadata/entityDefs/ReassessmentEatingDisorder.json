{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "trim": true,
            "options": []
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "contact": {
            "type": "link"
        },
        "baseline": {
            "notNull": true,
            "type": "bool",
            "isCustom": true
        },
        "date": {
            "notNull": false,
            "type": "date",
            "required": true,
            "isCustom": true,
            "default": "javascript: return this.dateTime.getToday();"
        },
        "improvement": {
            "type": "int",
            "isCustom": true,
            "readOnly": true
        },
        "initialScore": {
            "type": "int",
            "isCustom": true,
            "readOnly": true
        },
        "maxScore": {
            "type": "int",
            "isCustom": true,
            "default": 78,
            "readOnly": true
        },
        "score": {
            "type": "int",
            "isCustom": true,
            "readOnly": true
        },
        "level": {
            "type": "enum",
            "options": [
                "No measurable risk",
                "MINIMAL to MILD",
                "MODERATE",
                "HIGH"
            ],
            "style": {
                "No measurable risk": "success",
                "MINIMAL to MILD": "primary",
                "MODERATE": "warning",
                "HIGH": "danger"
            },
            "displayAsLabel": true,
            "default": "No measurable risk",
            "isCustom": true,
            "readOnly": true
        },
        "successMgmt": {
            "type": "enum",
            "options": [
                "N/A",
                "No Progress",
                "Improvement",
                "Significant Improvement",
                "Excellent Improvement"
            ],
            "style": {
                "N/A": null,
                "No Progress": "warning",
                "Improvement": "info",
                "Significant Improvement": "primary",
                "Excellent Improvement": "success"
            },
            "displayAsLabel": true,
            "default": "N/A",
            "isCustom": true,
            "readOnly": true
        },
