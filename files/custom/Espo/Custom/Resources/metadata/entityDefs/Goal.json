{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "trim": true,
            "options": []
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "contact": {
            "type": "link"
        },
        "dateAdded": {
            "notNull": false,
            "type": "date",
            "isCustom": true,
            "default": "javascript: return this.dateTime.getToday();"
        },
        "task": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "dueDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Planned",
                "Progressing",
                "Completed"
            ],
            "style": {
                "Planned": "warning",
                "Progressing": "primary",
                "Completed": "success"
            },
            "displayAsLabel": true,
            "default": "Planned",
            "isCustom": true
        },
        "actualCompletionDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "casenum": {
            "readOnly": true,
            "type": "foreign",
            "link": "contact",
            "field": "casenum",
            "view": "views/fields/foreign-varchar",
            "isCustom": true
        },
        "intervention": {
            "type": "enum",
            "required": true,
            "options": [
                "Lifestyle Intervention",
                "Benefits",
                "Employee Assistance Program",
                "Virtual Care",
                "Virtual CBT",
                "Public Health Program"
            ],
            "style": {
                "Lifestyle Intervention": null,
                "Benefits": null,
                "Employee Assistance Program": null,
                "Virtual Care": null,
                "Virtual CBT": null,
                "Public Health Program": null
            },
            "default": "Benefits",
            "isCustom": true
        },
        "interventionDetails": {
            "type": "enum",
            "options": [
                "N/A",
                "LI - Diet",
                "LI - Sleep Habits",
                "LI - Exercise",
                "LI - Caffeine Consumption",
                "LI - Harm Reduction",
                "LI - Nicotine Consumption",
                "LI - Alcohol Consumption",
                "LI - Socialization",
                "LI - Support Groups",
                "LI - Outdoor/Nature",
                "LI - Relaxation",
                "LI - Meditation",
                "LI - Stress Management",
                "LI - Journaling",
                "LI - Nutrition",
                "LI - Self-Care",
                "LI - Reduce Technology Use",
                "LI - Time Management",
                "B - Eligible practitioners",
                "B - Health Spending Account",
                "B - Personal spending account",
                "PH - Public Provincial CBT programs",
                "PH - Public Crisis services",
                "PH - Public Support groups",
                "PH - Other free resources",
                "EAP - RightDirections ",
                "VC - Lumino Health Virtual Care",
                "VC - Other",
                "VCBT - MindBeacon",
                "VCBT - Other"
            ],
            "style": {
                "N/A": null,
                "LI - Diet": null,
                "LI - Sleep Habits": null,
                "LI - Exercise": null,
                "LI - Caffeine Consumption": null,
                "LI - Harm Reduction": null,
                "LI - Nicotine Consumption": null,
                "LI - Alcohol Consumption": null,
                "LI - Socialization": null,
                "LI - Support Groups": null,
                "LI - Outdoor/Nature": null,
                "LI - Relaxation": null,
                "LI - Meditation": null,
                "LI - Stress Management": null,
                "LI - Journaling": null,
                "LI - Nutrition": null,
                "LI - Self-Care": null,
                "LI - Reduce Technology Use": null,
                "LI - Time Management": null,
                "B - Eligible practitioners": null,
                "B - Health Spending Account": null,
                "B - Personal spending account": null,
                "PH - Public Provincial CBT programs": null,
                "PH - Public Crisis services": null,
                "PH - Public Support groups": null,
                "PH - Other free resources": null,
                "EAP - RightDirections ": null,
                "VC - Lumino Health Virtual Care": null,
                "VC - Other": null,
                "VCBT - MindBeacon": null,
                "VCBT - Other": null
            },
            "isSorted": true,
            "default": "N/A",
            "isCustom": true,
            "required": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "EntityTeam",
            "layoutRelationshipsDisabled": true
        },
        "contact": {
            "type": "belongsTo",
            "foreign": "goals",
            "entity": "Contact",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "intervention",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        }
    }
