{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "trim": true,
            "options": []
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "q1": {
            "type": "enum",
            "options": [
                "None",
                "Less than 1 hr/day or occasional occurrence",
                "1 to 3 hrs/day or frequent",
                "Greater than 3 and up to 8 hrs/day or very frequent occurrence",
                "Greater than 8 hrs/day or nearly constant occurrence"
            ],
            "style": {
                "None": "success",
                "Less than 1 hr/day or occasional occurrence": "primary",
                "1 to 3 hrs/day or frequent": "info",
                "Greater than 3 and up to 8 hrs/day or very frequent occurrence": "warning",
                "Greater than 8 hrs/day or nearly constant occurrence": "danger"
            },
            "displayAsLabel": true,
            "default": null,
            "isCustom": true,
            "setDefaultNull": true
        },
        "q2": {
            "type": "enum",
            "options": [
                "None",
                "Slight interference with social or other activities, but overall performance not impaired",
                "Definite interference with social or occupational performance, but still manageable",
                "Causes substantial impairment in social or occupational performance",
                "Incapacitating"
            ],
            "style": {
                "None": "success",
                "Slight interference with social or other activities, but overall performance not impaired": "primary",
                "Definite interference with social or occupational performance, but still manageable": "info",
                "Causes substantial impairment in social or occupational performance": "warning",
                "Incapacitating": "danger"
            },
            "displayAsLabel": true,
            "default": null,
            "isCustom": true,
            "setDefaultNull": true
        },
        "q3": {
            "type": "enum",
            "options": [
                "None",
                "Not too disturbing",
                "Disturbing, but still manageable",
                "Very disturbing",
                "Near constant and disabling distress"
            ],
            "style": {
                "None": "success",
                "Not too disturbing": "primary",
                "Disturbing, but still manageable": "info",
                "Very disturbing": "warning",
                "Near constant and disabling distress": "danger"
            },
            "displayAsLabel": true,
            "default": null,
            "isCustom": true,
            "setDefaultNull": true
        },
        "q4": {
            "type": "enum",
            "options": [
                "Try to resist all the time",
                "Try to resist most of the time",
                "Make some effort to resist",
                "Yield to all obsessions without attempting to control them, but with some reluctance",
                "Completely and willingly yield to all obsessions"
            ],
            "style": {
                "Try to resist all the time": "success",
                "Try to resist most of the time": "primary",
                "Make some effort to resist": "info",
                "Yield to all obsessions without attempting to control them, but with some reluctance": "warning",
                "Completely and willingly yield to all obsessions": "danger"
            },
            "displayAsLabel": true,
            "default": null,
            "isCustom": true,
            "setDefaultNull": true
        },
        "q5": {
            "type": "enum",
            "options": [
                "Complete control",
                "Usually able to stop or divert obsessions with some effort and concentration",
                "Sometimes able to stop or divert obsessions",
                "Rarely successful in stopping or dismissing obsessions, can only divert attention with difficulty",
                "Obsessions are completely involuntary, rarely able to even momentarily alter obsessive thinking"
            ],
            "style": {
                "Complete control": "success",
                "Usually able to stop or divert obsessions with some effort and concentration": "primary",
                "Sometimes able to stop or divert obsessions": "info",
                "Rarely successful in stopping or dismissing obsessions, can only divert attention with difficulty": "warning",
                "Obsessions are completely involuntary, rarely able to even momentarily alter obsessive thinking": "danger"
            },
            "displayAsLabel": true,
            "default": null,
            "isCustom": true,
            "setDefaultNull": true
        },
        "q6": {
            "type": "enum",
            "options": [
                "None",
                "Less than 1 hr/day or occasional performance of compulsive behaviors",
                "From 1 to 3 hrs/day, or frequent performance of compulsive behaviors",
                "More than 3 and up to 8 hrs/day, or very frequent performance of compulsive behaviors",
                "More than 8 hrs/day, or near constant performance of compulsive behaviors (too numerous to count)"
            ],
            "style": {
                "None": "success",
                "Less than 1 hr/day or occasional performance of compulsive behaviors": "primary",
                "From 1 to 3 hrs/day, or frequent performance of compulsive behaviors": "info",
                "More than 3 and up to 8 hrs/day, or very frequent performance of compulsive behaviors": "warning",
                "More than 8 hrs/day, or near constant performance of compulsive behaviors (too numerous to count)": "danger"
            },
            "displayAsLabel": true,
            "default": null,
            "isCustom": true,
            "setDefaultNull": true
        },
        "q7": {
            "type": "enum",
            "options": [
                "None",
                "Slight interference with social or other activities, but overall performance not impaired",
                "Definite interference with social or occupational performance, but still manageable",
                "Causes substantial impairment in social or occupational performance",
                "Incapacitating"
            ],
            "style": {
                "None": "success",
                "Slight interference with social or other activities, but overall performance not impaired": "primary",
                "Definite interference with social or occupational performance, but still manageable": "info",
                "Causes substantial impairment in social or occupational performance": "warning",
                "Incapacitating": "danger"
            },
            "displayAsLabel": true,
            "default": null,
            "isCustom": true,
            "setDefaultNull": true
        },
        "q8": {
            "type": "enum",
            "options": [
                "None",
                "Only slightly anxious if compulsions prevented",
                "Anxiety would mount but remain manageable if compulsions prevented",
                "Prominent and very disturbing increase in anxiety if compulsions interrupted",
                "Incapacitating anxiety from any intervention aimed at modifying activity"
            ],
            "style": {
                "None": "success",
                "Only slightly anxious if compulsions prevented": "primary",
                "Anxiety would mount but remain manageable if compulsions prevented": "info",
                "Prominent and very disturbing increase in anxiety if compulsions interrupted": "warning",
                "Incapacitating anxiety from any intervention aimed at modifying activity": "danger"
            },
            "displayAsLabel": true,
            "default": null,
            "isCustom": true,
            "setDefaultNull": true
        },
        "q9": {
            "type": "enum",
            "options": [
                "Always try to resist",
                "Try to resist most of the time",
                "Make some effort to resist",
                "Yield to almost all compulsions without attempting to control them, but with some reluctance",
                "Completely and willingly yield to all compulsions"
            ],
            "style": {
                "Always try to resist": "success",
                "Try to resist most of the time": "primary",
                "Make some effort to resist": "info",
                "Yield to almost all compulsions without attempting to control them, but with some reluctance": "warning",
                "Completely and willingly yield to all compulsions": "danger"
            },
            "displayAsLabel": true,
            "default": null,
            "isCustom": true,
            "setDefaultNull": true
        },
        "q10": {
            "type": "enum",
            "options": [
                "Complete control",
                "Pressure to perform the behavior but usually able to exercise voluntary control over it",
                "Strong pressure to perform behavior, can control it only with difficulty",
                "Very strong drive to perform behavior, must be carried to completion, can only delay with difficulty",
                "Drive to perform behavior experienced as completely involuntary and overpowering"
            ],
            "style": {
                "Complete control": "success",
                "Pressure to perform the behavior but usually able to exercise voluntary control over it": "primary",
                "Strong pressure to perform behavior, can control it only with difficulty": "info",
                "Very strong drive to perform behavior, must be carried to completion, can only delay with difficulty": "warning",
                "Drive to perform behavior experienced as completely involuntary and overpowering": "danger"
            },
            "displayAsLabel": true,
            "default": null,
            "isCustom": true,
            "setDefaultNull": true
        },
        "baseline": {
            "notNull": true,
            "type": "bool",
            "isCustom": true
        },
        "date": {
            "notNull": false,
            "type": "date",
            "required": true,
            "isCustom": true,
            "default": "javascript: return this.dateTime.getToday();"
        },
        "improvement": {
            "type": "int",
            "isCustom": true,
            "readOnly": true
        },
        "initialScore": {
            "type": "int",
            "isCustom": true,
            "readOnly": true
        },
        "maxScore": {
            "type": "int",
            "isCustom": true,
            "default": 40,
            "readOnly": true
        },
        "score": {
            "type": "int",
            "isCustom": true,
            "readOnly": true
        },
        "level": {
            "type": "enum",
            "options": [
                "No measurable risk",
                "MINIMAL to MILD",
                "MODERATE",
                "HIGH"
            ],
            "style": {
                "No measurable risk": "success",
                "MINIMAL to MILD": "primary",
                "MODERATE": "warning",
                "HIGH": "danger"
            },
            "default": "No measurable risk",
            "isCustom": true,
            "displayAsLabel": true,
            "readOnly": true
        },
        "successMgmt": {
            "type": "enum",
            "options": [
                "N/A",
                "No Progress",
                "Improvement",
                "Significant Improvement",
                "Excellent Improvement"
            ],
            "style": {
                "N/A": null,
                "No Progress": "warning",
                "Improvement": "info",
                "Significant Improvement": "primary",
                "Excellent Improvement": "success"
            },
            "default": "N/A",
            "isCustom": true,
            "displayAsLabel": true,
            "readOnly": true
        },
        "contact": {
            "type": "link"
        },
        "latest": {
            "notNull": true,
            "type": "bool",
            "isCustom": true
        },
        "type": {
            "type": "enum",
            "options": [
                "Reassessment",
                "Current Baseline",
                "Baseline"
            ],
            "style": {
                "Reassessment": "success",
                "Current Baseline": "danger",
                "Baseline": "warning"
            },
            "displayAsLabel": true,
            "default": "Reassessment",
            "isCustom": true
        },
        "incompleteAssessment": {
            "notNull": true,
            "type": "bool",
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "EntityTeam",
            "layoutRelationshipsDisabled": true
        },
        "contact": {
            "type": "belongsTo",
            "foreign": "reassessmentOCDs",
            "entity": "Contact",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "date",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        }
    }
}