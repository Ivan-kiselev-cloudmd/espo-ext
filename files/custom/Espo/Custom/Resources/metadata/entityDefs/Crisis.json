{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "trim": true,
            "options": []
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "contact": {
            "type": "link"
        },
        "date": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "call": {
            "type": "enum",
            "options": [
                "1",
                "2",
                "3",
                "4",
                "5",
                "6"
            ],
            "style": {
                "1": null,
                "2": null,
                "3": null,
                "4": null,
                "5": null,
                "6": null
            },
            "default": "1",
            "isCustom": true
        },
        "crisisRiskLevel": {
            "type": "enum",
            "options": [
                "N/A",
                "High",
                "Moderate",
                "Low"
            ],
            "style": {
                "N/A": null,
                "High": "danger",
                "Moderate": "warning",
                "Low": "success"
            },
            "displayAsLabel": true,
            "default": "N/A",
            "isCustom": true
        },
        "activePlan": {
            "type": "enum",
            "options": [
                "N/A",
                "Yes",
                "No"
            ],
            "style": {
                "N/A": null,
                "Yes": null,
                "No": null
            },
            "displayAsLabel": true,
            "default": "N/A",
            "isCustom": true
        },
        "previousSuicide": {
            "type": "enum",
            "options": [
                "N/A",
                "Yes",
                "No"
            ],
            "style": {
                "N/A": null,
                "Yes": "danger",
                "No": "success"
            },
            "displayAsLabel": true,
            "default": "N/A",
            "isCustom": true
        },
        "worthLiving": {
            "type": "enum",
            "options": [
                "N/A",
                "Yes",
                "No"
            ],
            "style": {
                "N/A": null,
                "Yes": "success",
                "No": "danger"
            },
            "displayAsLabel": true,
            "default": "N/A",
            "isCustom": true
        },
        "handle": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "tooltip": true,
            "isCustom": true
        },
        "casenum": {
            "readOnly": true,
            "type": "foreign",
            "link": "contact",
            "field": "casenum",
            "view": "views/fields/foreign-varchar",
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "EntityTeam",
            "layoutRelationshipsDisabled": true
        },
        "contact": {
            "type": "belongsTo",
            "foreign": "crisiss",
            "entity": "Contact",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        }
    }
}