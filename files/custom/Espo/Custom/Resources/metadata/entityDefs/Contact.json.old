            "type": "enum",
            "options": [
                "Incomplete Assessment",
                "MH coach appointment reminder",
                "Review client’s Assessment",
                "Call with Client",
                "Research Resources",
                "Coach Reviews Selections",
                "Generate Action Plan",
                "Send Personalized Action Plan",
                "Send Satisfaction Survey to Client",
                "Send Progress Follow-Up Survey to Client",
                "Review Progress Follow-Up Survey",
                "Invite Client to redo Snap Clarity Assessment",
                "Close Case"
            ],
            "style": {
                "Incomplete Assessment": null,
                "MH coach appointment reminder": null,
                "Review client’s Assessment": "danger",
                "Call with Client": "danger",
                "Research Resources": "success",
                "Coach Reviews Selections": "danger",
                "Generate Action Plan": "success",
                "Send Personalized Action Plan": "danger",
                "Send Satisfaction Survey to Client": null,
                "Send Progress Follow-Up Survey to Client": null,
                "Review Progress Follow-Up Survey": "danger",
                "Invite Client to redo Snap Clarity Assessment": null,
                "Close Case": null
            },
            "default": "Incomplete Assessment",
            "isCustom": true
        },
        "reassessmentDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
