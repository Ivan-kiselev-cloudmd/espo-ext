{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "trim": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "contact": {
            "type": "link"
        },
        "level": {
            "type": "enum",
            "options": [
                "HIGH",
                "MODERATE",
                "MINIMAL to MILD",
                "N/A"
            ],
            "style": {
                "HIGH": "danger",
                "MODERATE": "warning",
                "MINIMAL to MILD": "success",
                "N/A": null
            },
            "default": "N/A",
            "isCustom": true,
            "displayAsLabel": true
        },
        "casenum": {
            "readOnly": true,
            "type": "foreign",
            "link": "contact",
            "field": "casenum",
            "view": "views/fields/foreign-varchar",
            "isCustom": true
        },
        "maxScore": {
            "type": "int",
            "isCustom": true
        },
        "diagnosisname": {
            "type": "enum",
            "options": [
                "N/A",
                "Alcohol Use Disorder",
                "Attention Deficit Hyperactivity Disorder",
                "Bipolar Disorder",
                "Depression Disorder",
                "Eating Disorder",
                "Generalized Anxiety Disorder",
                "Intermittent Explosive Disorder",
                "Obsessive-Compulsive Disorder",
                "Panic Disorder",
                "Post-Traumatic Stress-Disorder",
                "Sleep Disorder",
                "Social Anxiety Disorder",
                "Substance Use Disorder"
            ],
            "style": {
                "N/A": null,
                "Alcohol Use Disorder": null,
                "Attention Deficit Hyperactivity Disorder": null,
                "Bipolar Disorder": null,
                "Depression Disorder": null,
                "Eating Disorder": null,
                "Generalized Anxiety Disorder": null,
                "Intermittent Explosive Disorder": null,
                "Obsessive-Compulsive Disorder": null,
                "Panic Disorder": null,
                "Post-Traumatic Stress-Disorder": null,
                "Sleep Disorder": null,
                "Social Anxiety Disorder": null,
                "Substance Use Disorder": null
            },
            "default": "N/A",
            "isCustom": true
        },
        "score": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "reportedLevel": {
            "type": "enum",
            "options": [
                "HIGH",
                "MODERATE",
                "MINIMAL to MILD",
                "No measurable risk"
            ],
            "style": {
                "HIGH": "danger",
                "MODERATE": "warning",
                "MINIMAL to MILD": "primary",
                "No measurable risk": "success"
            },
            "default": "No measurable risk",
            "displayAsLabel": true,
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "EntityTeam",
            "layoutRelationshipsDisabled": true
        },
        "contact": {
            "type": "belongsTo",
            "foreign": "assessmentScores",
            "entity": "Contact",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "reportedLevel",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        }
    }
}