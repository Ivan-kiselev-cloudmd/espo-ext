{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "trim": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "email": {
            "type": "varchar",
            "maxLength": 150,
            "trim": true,
            "options": [],
            "isCustom": true
        },
        "resourcesProvidedWereRelevant": {
            "type": "enum",
            "options": [
                "N/A",
                "Strongly Agree",
                "Agree",
                "Neutral",
                "Disagree",
                "Strongly Disagree"
            ],
            "style": {
                "N/A": null,
                "Strongly Agree": "success",
                "Agree": "primary",
                "Neutral": "info",
                "Disagree": "warning",
                "Strongly Disagree": "danger"
            },
            "default": "N/A",
            "tooltip": true,
            "isCustom": true,
            "displayAsLabel": true
        },
        "satisfiedWithTheService": {
            "type": "enum",
            "options": [
                "N/A",
                "Strongly Agree",
                "Agree",
                "Neutral",
                "Disagree",
                "Strongly Disagree"
            ],
            "style": {
                "N/A": null,
                "Strongly Agree": "success",
                "Agree": "primary",
                "Neutral": "info",
                "Disagree": "warning",
                "Strongly Disagree": "danger"
            },
            "default": "N/A",
            "tooltip": true,
            "isCustom": true,
            "displayAsLabel": true
        },
        "benefitsBetterUnderstanding": {
            "type": "enum",
            "options": [
                "N/A",
                "Strongly Agree",
                "Agree",
                "Neutral",
                "Disagree",
                "Strongly Disagree"
            ],
            "style": {
                "N/A": null,
                "Strongly Agree": "success",
                "Agree": "primary",
                "Neutral": "info",
                "Disagree": "warning",
                "Strongly Disagree": "danger"
            },
            "default": "N/A",
            "tooltip": true,
            "isCustom": true,
            "displayAsLabel": true
        },
        "recommendServiceToOthers": {
            "type": "enum",
            "options": [
                "N/A",
                "Very Likely",
                "Somewhat Likely",
                "Not Sure",
                "Not Likely",
                "Not Likely At All"
            ],
            "style": {
                "N/A": null,
                "Very Likely": "success",
                "Somewhat Likely": "primary",
                "Not Sure": "info",
                "Not Likely": "warning",
                "Not Likely At All": "danger"
            },
            "default": "N/A",
            "tooltip": true,
            "isCustom": true,
            "displayAsLabel": true
        },
        "whatMadeYouEngageInTheService": {
            "type": "multiEnum",
            "storeArrayValues": true,
            "options": [
                "Other",
                "I was curious and wanted to see what it was about.",
                "I thought this would be a therapy session.",
                "I feel like I could use some help/support with my mental health.",
                "I was advised to try it."
            ],
            "style": {
                "Other": null,
                "I was curious and wanted to see what it was about.": null,
                "I thought this would be a therapy session.": null,
                "I feel like I could use some help/support with my mental health.": null,
                "I was advised to try it.": null
            },
            "isCustom": true
        },
        "language": {
            "type": "enum",
            "options": [
                "EN",
                "FR"
            ],
            "style": {
                "EN": "danger",
                "FR": "primary"
            },
            "default": "EN",
            "isCustom": true,
            "displayAsLabel": true
        },
        "whatMadeYouEngageInTheServiceOther": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "contact": {
            "type": "linkOne"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "EntityTeam",
            "layoutRelationshipsDisabled": true
        },
        "contact": {
            "type": "hasOne",
            "foreign": "satisfactionSurvey",
            "entity": "Contact",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        }
    }
}