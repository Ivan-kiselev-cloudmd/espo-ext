{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "trim": true,
            "options": []
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "diagnosis": {
            "type": "multiEnum",
            "storeArrayValues": true,
            "isSorted": true,
            "options": [
                "Alcohol Use Disorder",
                "Attention Deficit Hyperactivity Disorder",
                "Bipolar Disorder",
                "Depression Disorder",
                "Eating Disorder",
                "Generalized Anxiety Disorder",
                "Intermittent Explosive Disorder",
                "Obsessive-Compulsive Disorder",
                "Panic Disorder",
                "Post-Traumatic Stress-Disorder",
                "Sleep Disorder",
                "Social Anxiety Disorder",
                "Substance Use Disorder",
                "Schizophrenia",
                "Multiple Personality Disorder",
                "Borderline personality disorder"
            ],
            "style": {
                "Alcohol Use Disorder": null,
                "Attention Deficit Hyperactivity Disorder": null,
                "Bipolar Disorder": null,
                "Depression Disorder": null,
                "Eating Disorder": null,
                "Generalized Anxiety Disorder": null,
                "Intermittent Explosive Disorder": null,
                "Obsessive-Compulsive Disorder": null,
                "Panic Disorder": null,
                "Post-Traumatic Stress-Disorder": null,
                "Sleep Disorder": null,
                "Social Anxiety Disorder": null,
                "Substance Use Disorder": null,
                "Schizophrenia": null,
                "Multiple Personality Disorder": null,
                "Borderline personality disorder": null
            },
            "isCustom": true
        },
        "copingTools": {
            "type": "enum",
            "options": [
                "N/A",
                "None",
                "Seeing a professional",
                "Speaking with/support from friends/family",
                "Practicing self-care",
                "Self-medicating (food, alcohol, medication)",
                "Have not been managing"
            ],
            "style": {
                "N/A": null,
                "None": null,
                "Seeing a professional": null,
                "Speaking with/support from friends/family": null,
                "Practicing self-care": null,
                "Self-medicating (food, alcohol, medication)": null,
                "Have not been managing": null
            },
            "displayAsLabel": true,
            "default": "N/A",
            "isCustom": true
        },
        "selfperceptionOfCopingAbility": {
            "type": "enum",
            "options": [
                "N/A",
                "Well",
                "Manageble",
                "Good and Bad days",
                "Not managing",
                "Other"
            ],
            "style": {
                "N/A": null,
                "Well": "success",
                "Manageble": "primary",
                "Good and Bad days": "warning",
                "Not managing": "danger",
                "Other": "info"
            },
            "displayAsLabel": true,
            "default": "N/A",
            "isCustom": true
        },
        "relation": {
            "type": "enum",
            "options": [
                "Client",
                "Mother",
                "Father",
                "Grandparent",
                "Sister",
                "Brother",
                "Other"
            ],
            "style": {
                "Client": null,
                "Mother": null,
                "Father": null,
                "Grandparent": null,
                "Sister": null,
                "Brother": null,
                "Other": null
            },
            "default": "Client",
            "isCustom": true
        },
        "relationOther": {
            "type": "varchar",
            "maxLength": 150,
            "trim": true,
            "options": [],
            "isCustom": true
        },
        "selfperceptionOfCopingAbilityDetails": {
            "type": "varchar",
            "maxLength": 150,
            "trim": true,
            "options": [],
            "isCustom": true
        },
        "medicalIntake": {
            "type": "link"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "EntityTeam",
            "layoutRelationshipsDisabled": true
        },
        "medicalIntake": {
            "type": "belongsTo",
            "foreign": "medicalHistories",
            "entity": "MedicalIntake",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        }
    }
}