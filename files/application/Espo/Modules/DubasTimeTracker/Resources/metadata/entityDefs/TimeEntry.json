{
    "fields": {
        "name": {
            "type": "varchar",
            "view": "dubas-time-tracker:views/time-entry/fields/name"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true
        },
        "assignedUser": {
            "type": "link",
            "required": true,
            "view": "views/fields/assigned-user"
        },
        "dateStart": {
            "type": "datetime",
            "required": true,
            "hasSeconds": true,
            "default": "javascript: return this.dateTime.getNow(1);",
            "minuteStep": 1
        },
        "dateEnd": {
            "type": "datetime",
            "view": "dubas-time-tracker:views/time-entry/fields/date-end",
            "after": "dateStart",
            "hasSeconds": true
        },
        "duration": {
            "type": "int",
            "view": "dubas-time-tracker:views/time-tracker/fields/duration",
            "disableFormatting": true,
            "readOnly": true
        },
        "parent": {
            "type": "link",
            "readOnly": true
        },
        "target": {
            "type": "base",
            "view": "dubas-time-tracker:views/time-entry/fields/target",
            "customizationDisabled": true,
            "disabled": true,
            "notStorable": true
        },
        "targetId": {
            "type": "foreign",
            "link": "parent",
            "field": "targetId",
            "view": "views/fields/foreign-enum",
            "customizationDisabled": true,
            "disabled": true,
            "notStorable": true
        },
        "targetType": {
            "type": "foreign",
            "link": "parent",
            "field": "targetType",
            "view": "views/fields/foreign-enum",
            "customizationDisabled": true,
            "disabled": true,
            "notStorable": true
        },
        "targetName": {
            "type": "varchar",
            "customizationDisabled": true,
            "disabled": true,
            "notStorable": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "parent": {
            "type": "belongsTo",
            "entity": "TimeTracker",
            "foreign": "timeEntries"
        }
    },
    "collection": {
        "orderBy": "dateStart",
        "order": "desc"
    }
}
